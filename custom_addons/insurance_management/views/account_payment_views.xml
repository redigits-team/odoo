<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Payment Form View -->
    <record id="view_account_payment_form_insurance" model="ir.ui.view">
        <field name="name">account.payment.form.insurance</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_policy_payment" invisible="1"/>
                <field name="policy_id" invisible="not is_policy_payment"/>
                <field name="installment_number" invisible="not is_policy_payment"/>
                <field name="payment_status" widget="badge" 
                       invisible="not is_policy_payment"
                       decoration-success="payment_status == 'paid'"
                       decoration-warning="payment_status == 'pending'"
                       decoration-danger="payment_status == 'late'"/>
            </xpath>
        </field>
    </record>

    <!-- Payment Tree View -->
    <record id="view_account_payment_tree_insurance" model="ir.ui.view">
        <field name="name">account.payment.tree.insurance</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="policy_id" optional="show"/>
                <field name="installment_number" optional="show"/>
                <field name="payment_status" widget="badge" optional="show"
                       decoration-success="payment_status == 'paid'"
                       decoration-warning="payment_status == 'pending'"
                       decoration-danger="payment_status == 'late'"/>
            </xpath>
        </field>
    </record>

    <!-- Payment Search View -->
    <record id="view_account_payment_search_insurance" model="ir.ui.view">
        <field name="name">account.payment.search.insurance</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="policy_id"/>
            </xpath>
            <xpath expr="//filter[@name='state_sent']" position="after">
                <separator/>
                <filter string="Policy Payments" name="policy_payments" domain="[('is_policy_payment', '=', True)]"/>
                <filter string="Late Payments" name="late_payments" domain="[('payment_status', '=', 'late')]"/>
                <filter string="Pending Payments" name="pending_payments" domain="[('payment_status', '=', 'pending')]"/>
                <filter string="Paid Payments" name="paid_payments" domain="[('payment_status', '=', 'paid')]"/>
            </xpath>
            <xpath expr="//filter[@name='company']" position="after">
                <filter string="Policy" name="group_by_policy" domain="[]" context="{'group_by': 'policy_id'}"/>
                <filter string="Payment Status" name="group_by_status" domain="[]" context="{'group_by': 'payment_status'}"/>
            </xpath>
        </field>
    </record>

    <!-- Insurance Payments Action -->
    <record id="action_insurance_payments" model="ir.actions.act_window">
        <field name="name">Insurance Payments</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form,graph</field>
        <field name="domain">[('is_policy_payment', '=', True)]</field>
        <field name="context">{'search_default_policy_payments': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new insurance payment
            </p>
        </field>
    </record>
</odoo>