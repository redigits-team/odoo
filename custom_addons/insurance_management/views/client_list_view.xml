<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Enhanced Client List View -->
    <record id="view_insurance_client_list" model="ir.ui.view">
        <field name="name">insurance.client.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Insurance Clients">
                <field name="name" string="Client Name"/>
                <field name="phone" optional="show"/>
                <field name="email" optional="show"/>
                <field name="tax_id_number"/>
                <field name="profession"/>
                <field name="agent_id"/>
                <field name="policy_count" string="Policies" widget="integer_badge"/>
                <field name="country_id" optional="show"/>
                <field name="is_insurance_agent" invisible="1"/>
                <field name="mobile" optional="hide"/>
                <field name="user_id" optional="hide"/>
                <field name="vat" optional="hide" string="Tax ID"/>
                <field name="category_id" optional="hide" widget="many2many_tags"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
    
    <!-- Enhanced Client Search View -->
    <record id="view_insurance_client_filter" model="ir.ui.view">
        <field name="name">insurance.client.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Search Insurance Clients">
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('email', 'ilike', self), ('phone', 'ilike', self)]"/>
                <field name="tax_id_number"/>
                <field name="profession"/>
                <field name="agent_id"/>
                
                <separator/>
                <filter string="Clients with Policies" name="has_policies" domain="[('policy_count', '>', 0)]"/>
                <filter string="Clients without Policies" name="no_policies" domain="[('policy_count', '=', 0)]"/>
                <filter string="Insurance Agents" name="insurance_agents" domain="[('is_insurance_agent', '=', True)]"/>
                <filter string="Customers" name="customer" domain="[('customer_rank', '>', 0)]"/>
                
                <separator/>
                <filter string="Created Today" name="created_today" domain="[('create_date', '>=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))), ('create_date', '&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)))]"/>
                <filter string="Created this Month" name="created_month" domain="[('create_date', '>=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d')), ('create_date', '&lt;=', (context_today() + relativedelta(months=1, day=1, days=-1)).strftime('%Y-%m-%d'))]"/>
                
                <group expand="0" string="Group By">
                    <filter string="Insurance Agent" name="agent" domain="[]" context="{'group_by': 'agent_id'}"/>
                    <filter string="Profession" name="profession" domain="[]" context="{'group_by': 'profession'}"/>
                    <filter string="Country" name="country" domain="[]" context="{'group_by': 'country_id'}"/>
                    <filter string="Company" name="company" domain="[]" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Enhanced Client Kanban View -->
    <record id="view_insurance_client_kanban" model="ir.ui.view">
        <field name="name">insurance.client.kanban</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban string="Insurance Clients" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="mobile"/>
                <field name="tax_id_number"/>
                <field name="profession"/>
                <field name="agent_id"/>
                <field name="policy_count"/>
                <field name="is_insurance_agent"/>
                <field name="color"/>
                <field name="image_128"/>
                
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click o_res_partner_kanban o_kanban_record">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('res.partner', 'image_128', record.id.raw_value)" alt="Client Image"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <div class="o_kanban_tags_section">
                                    <span t-if="record.is_insurance_agent.raw_value" class="badge rounded-pill text-bg-success">Agent</span>
                                </div>
                                <ul>
                                    <li t-if="record.phone.raw_value">
                                        <field name="phone"/> (Phone)
                                    </li>
                                    <li t-if="record.email.raw_value">
                                        <field name="email"/>
                                    </li>
                                    <li t-if="record.profession.raw_value">
                                        Profession: <field name="profession"/>
                                    </li>
                                    <li t-if="record.agent_id.raw_value and !record.is_insurance_agent.raw_value">
                                        Agent: <field name="agent_id"/>
                                    </li>
                                </ul>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="policy_count" widget="integer_badge" decoration-danger="policy_count == 0"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <button t-if="record.policy_count.raw_value > 0" name="action_view_policies" type="object" class="btn btn-sm btn-link">
                                            <span>View Policies</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- Enhanced Client Action -->
    <record id="action_insurance_clients" model="ir.actions.act_window">
        <field name="name">Insurance Clients</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_company', '=', False)]</field>
        <field name="context">{'search_default_customer': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0),
                 (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_insurance_client_kanban')}),
                 (0, 0, {'view_mode': 'list', 'view_id': ref('view_insurance_client_list')})]"/>
        <field name="search_view_id" ref="view_insurance_client_filter"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new insurance client
            </p>
        </field>
    </record>
</odoo>