<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Basic scheduled actions for insurance module -->
        <record id="ir_cron_insurance_daily_tasks" model="ir.cron">
            <field name="name">Insurance: Daily Management Tasks</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model._run_insurance_daily_tasks()</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>